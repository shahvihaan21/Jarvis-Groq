# Copy this file to `.env` for local development.
# On Render/Railway/Vercel, set these in the dashboard Environment settings instead.

# Get one at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your_random_secret_key_here

# Never enable DEBUG in production
DEBUG=False

# Optional overrides
# GROQ_MODEL=openai/gpt-oss-120b   (override the production default if needed)
# ALLOWED_HOSTS=your-app.onrender.com,yourapp.up.railway.app
# CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com
# CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
